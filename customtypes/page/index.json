{
  "format": "page",
  "id": "page",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "slices": {
        "config": {
          "choices": {
            "hero": {
              "type": "SharedSlice"
            },
            "featured_profile": {
              "type": "SharedSlice"
            },
            "initiative_feature": {
              "type": "SharedSlice"
            },
            "feature_grid": {
              "type": "SharedSlice"
            },
            "impact_overview": {
              "type": "SharedSlice"
            },
            "foundation_overview": {
              "type": "SharedSlice"
            },
            "vision_mission": {
              "type": "SharedSlice"
            },
            "contact_inquiry": {
              "type": "SharedSlice"
            },
            "pillar_feature": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Slice Zone",
        "type": "Slices"
      },
      "title": {
        "config": {
          "label": "Title",
          "single": "heading1"
        },
        "type": "StructuredText"
      }
    },
    "SEO & Metadata": {
      "meta_title": {
        "config": {
          "label": "Meta Title",
          "placeholder": "A title of the page used for social media and search engines"
        },
        "type": "Text"
      },
      "meta_description": {
        "config": {
          "label": "Meta Description",
          "placeholder": "A brief summary of the page"
        },
        "type": "Text"
      },
      "meta_image": {
        "config": {
          "constraint": {
            "height": 1260,
            "width": 2400
          },
          "label": "Meta Image",
          "thumbnails": []
        },
        "type": "Image"
      },
      "og_title": {
        "config": {
          "label": "Social sharing title"
        },
        "type": "Text"
      },
      "og_description": {
        "config": {
          "label": "Social sharing description"
        },
        "type": "Text"
      },
      "og_image": {
        "config": {
          "label": "Social sharing image (1200 x 630)"
        },
        "type": "Image"
      },
      "noindex": {
        "config": {
          "label": "Hide this page from search engines"
        },
        "type": "Boolean"
      },
      "schema_type": {
        "config": {
          "label": "Page schema type",
          "options": ["WebPage", "AboutPage", "ContactPage", "CollectionPage"]
        },
        "type": "Select"
      }
    }
  },
  "label": "Page",
  "repeatable": true,
  "status": true
}
