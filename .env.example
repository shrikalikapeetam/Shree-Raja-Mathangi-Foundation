# Canonical production origin (no path). Required before enabling search indexing.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_PRISMIC_REPOSITORY_NAME=shree-raja-mathangi-foundation
# Optional read token, only required if the Content API is private.
PRISMIC_ACCESS_TOKEN=
# Private write token for model/content management. Never use NEXT_PUBLIC_ here.
PRISMIC_WRITE_TOKEN=

# Contact notifications go to admin@shreerajamathangifoundation.org and pritam.soni13@gmail.com.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dedicated foundation PostgreSQL database; do not reuse another project's database.
DATABASE_URL=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated administrator email allowlist (no public admin signup).
ADMIN_EMAILS=
ADMIN_ENABLED=false
# Separate 32-byte base64 encryption key for donor PAN. Back up securely.
DONOR_DATA_KEY=
