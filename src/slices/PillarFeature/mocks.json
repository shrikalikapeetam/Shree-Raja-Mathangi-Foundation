      "project_title": [
        {
          "type": "heading3",
          "text": "A home for lifelong care",
          "spans": []
        }
      ],
      "project_content": [
        {
          "type": "paragraph",
          "text": "The Foundation has started constructing a goshala on a 4-acre plot near the Sri Raja Mathangi Sametha Sri Raja Rajeshwara Temple, located in Keezhanthurai Village near Arakonam, Tamil Nadu.",
          "spans": []
        },
        {
          "type": "paragraph",
          "text": "The four-acre plot will house three sheds for 150 animals, a feed storage shed, a quarantine shed, and a clinic.",
          "spans": []
        },
        {
          "type": "paragraph",
          "text": "On the remaining 3 acres, fodder grass is also cultivated to ensure year-round availability of green fodder for the cows.",
          "spans": []
        }
      ],
